<!-- ═══ HERO ═══ -->
<section class="page-hero">
  <div class="page-hero-badge">🏆 Dubai's Trusted Waterproofing Specialists</div>
  <h1>Built on <span>Trust.</span><br>Backed by <span>Results.</span></h1>
  <p>Dubai Roof Seal is a specialist waterproofing and roof repair company based in Jebel Ali, Dubai — serving villas, warehouses and commercial buildings across the UAE, 7 days a week.</p>
  <div class="breadcrumb">
    <a href="index.html">Home</a>
    <span>›</span>
    <span>About Us</span>
  </div>
</section>

<!-- ═══ STATS ═══ -->
<div class="stats-strip">
  <div class="stats-inner">
    <div class="stat-item">
      <div class="stat-num">100+</div>
      <div class="stat-label">Projects Completed</div>
    </div>
    <div class="stat-item">
      <div class="stat-num">5 Yr</div>
      <div class="stat-label">Written Warranty</div>
    </div>
    <div class="stat-item">
      <div class="stat-num">24–48h</div>
