<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-Content-Type-Options" content="nosniff" />
  <meta http-equiv="X-Frame-Options" content="SAMEORIGIN" />
  <title>About Us | Dubai Roof Seal — Roof Waterproofing Specialists Dubai</title>
  <meta name="description" content="Dubai Roof Seal — specialist roof waterproofing company based in Jebel Ali, Dubai. Learn about our team, values, warranty promise and why 100+ clients across the UAE trust us." />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://dubairoofseal.com/about.html" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://dubairoofseal.com/about.html" />
  <meta property="og:title" content="About Dubai Roof Seal" />
  <meta property="og:description" content="Specialist roof waterproofing company in Dubai. Free inspection. 5-year warranty. 7 days a week." />
  <meta property="og:image" content="https://dubairoofseal.com/og-image.jpg" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Open+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root{--navy:#1A3A5C;--gold:#E8A020;--teal:#0F6E56;--white:#FFFFFF;--light-bg:#F4F7FB;--dark-text:#2C2C2C;--light-text:#555;--border:#dde3ed;}
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    html{scroll-behavior:smooth;scroll-padding-top:104px;}
    body{font-family:'Open Sans',Arial,sans-serif;color:var(--dark-text);background:#fff;}
    img{max-width:100%;display:block;}a{text-decoration:none;color:inherit;}ul{list-style:none;}

    /* ── TOP BAR ── */
    .top-bar{background:#060f1c;padding:7px 24px;display:flex;align-items:center;justify-content:center;gap:32px;flex-wrap:wrap;}
    .top-bar a{display:inline-flex;align-items:center;gap:7px;color:rgba(255,255,255,0.78);font-size:0.78rem;font-weight:500;transition:color .2s;white-space:nowrap;}
    .top-bar a:hover{color:var(--gold);}
    .top-bar a svg{width:14px;height:14px;fill:var(--gold);flex-shrink:0;}
    .top-bar-sep{color:rgba(255,255,255,0.2);font-size:.7rem;}
    @media(max-width:600px){.top-bar{gap:14px;}.top-bar-sep{display:none;}}

    /* ── HEADER ── */
    header{position:fixed;top:0;left:0;right:0;z-index:1000;background:var(--navy);box-shadow:0 2px 12px rgba(0,0,0,.18);display:flex;flex-direction:column;}
    nav{max-width:1200px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;padding:0 24px;height:80px;}
    .logo{display:flex;align-items:center;gap:10px;}
    .nav-logo{height:68px;width:auto;filter:invert(1);mix-blend-mode:screen;transition:opacity .2s;}
    .nav-logo:hover{opacity:.85;}
    .logo-text{display:flex;flex-direction:column;justify-content:center;line-height:1;}
    .logo-name{font-family:'Montserrat',sans-serif;font-weight:800;font-size:1.15rem;color:var(--white);letter-spacing:-.3px;line-height:1.2;}
    .logo-tag{font-family:'Montserrat',sans-serif;font-weight:500;font-size:.62rem;color:var(--teal);letter-spacing:.08em;text-transform:uppercase;margin-top:3px;}
    .nav-links{display:flex;gap:32px;align-items:center;}
    .nav-links a{color:rgba(255,255,255,.85);font-size:.9rem;font-weight:500;transition:color .2s;padding:8px 0;}
    .nav-links a:hover,.nav-links a.active{color:var(--gold);}
    .nav-has-drop{position:relative;}
    .nav-dropdown{display:none;position:absolute;top:100%;left:50%;transform:translateX(-50%);background:var(--white);border-radius:10px;min-width:220px;box-shadow:0 8px 32px rgba(0,0,0,.13);padding:8px 0;z-index:200;}
    .nav-has-drop:hover .nav-dropdown{display:block;}
    .nav-dropdown li a{display:block;padding:11px 22px;color:var(--navy)!important;font-size:.875rem;font-weight:500;transition:background .15s;}
    .nav-dropdown li a:hover{background:var(--light-bg);color:var(--teal)!important;}
    .nav-cta{background:var(--gold);color:var(--navy)!important;font-weight:700!important;padding:9px 20px;border-radius:6px;transition:background .2s,transform .15s!important;}
    .nav-cta:hover{background:#d4911a!important;transform:translateY(-1px);}
    .hamburger{display:none;cursor:pointer;flex-direction:column;gap:5px;}
    .hamburger span{width:26px;height:2.5px;background:#fff;border-radius:2px;transition:.3s;}

    /* ── PAGE HERO ── */
    .page-hero{background:linear-gradient(135deg,#0d2540 0%,var(--navy) 55%,#1a4a6e 100%);padding:160px 24px 90px;text-align:center;position:relative;overflow:hidden;}
    .page-hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 30% 60%,rgba(15,110,86,.12) 0%,transparent 55%);}
    .page-hero::after{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 80% 30%,rgba(232,160,32,.07) 0%,transparent 55%);}
    .page-hero-badge{display:inline-block;background:rgba(15,110,86,.18);border:1px solid rgba(15,110,86,.4);color:#4ecba0;font-size:.75rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:6px 18px;border-radius:20px;margin-bottom:20px;}
    .page-hero h1{font-family:'Montserrat',sans-serif;font-size:clamp(2rem,5vw,3.2rem);font-weight:800;color:var(--white);line-height:1.15;margin-bottom:16px;}
    .page-hero h1 span{color:var(--gold);}
    .page-hero p{font-size:1.05rem;color:rgba(255,255,255,.78);max-width:580px;margin:0 auto 28px;line-height:1.75;}
    .breadcrumb{display:flex;justify-content:center;gap:8px;font-size:.8rem;color:rgba(255,255,255,.45);margin-top:20px;}
    .breadcrumb a{color:rgba(255,255,255,.55);transition:color .2s;}
    .breadcrumb a:hover{color:var(--gold);}
    .breadcrumb span{color:var(--gold);}

    /* ── SHARED ── */
    .wrap{max-width:1200px;margin:0 auto;padding:0 24px;}
    .label{font-family:'Montserrat',sans-serif;font-size:.72rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--teal);display:block;margin-bottom:10px;}
    .title{font-family:'Montserrat',sans-serif;font-size:clamp(1.6rem,3.5vw,2.4rem);font-weight:800;color:var(--navy);line-height:1.2;margin-bottom:14px;}
    .title span{color:var(--gold);}
    .body-text{font-size:1rem;color:var(--light-text);line-height:1.8;}

    /* ── STATS STRIP ── */
    .stats-strip{background:var(--gold);padding:0;}
    .stats-inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);}
    .stat-item{padding:36px 24px;text-align:center;border-right:1px solid rgba(26,58,92,.15);}
    .stat-item:last-child{border-right:none;}
    .stat-num{font-family:'Montserrat',sans-serif;font-size:clamp(2rem,4vw,3rem);font-weight:800;color:var(--navy);line-height:1;}
    .stat-label{font-family:'Montserrat',sans-serif;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:rgba(26,58,92,.7);margin-top:6px;}
    @media(max-width:700px){.stats-inner{grid-template-columns:1fr 1fr;}.stat-item{border-right:none;border-bottom:1px solid rgba(26,58,92,.12);}}

    /* ── WHO WE ARE ── */
    .who-section{padding:90px 0;background:#fff;}
    .who-grid{display:grid;grid-template-columns:1fr 1fr;gap:72px;align-items:center;}
    .who-visual{position:relative;}
    .who-card{background:var(--navy);border-radius:20px;padding:40px;color:#fff;position:relative;overflow:hidden;}
    .who-card::before{content:'';position:absolute;top:-40px;right:-40px;width:180px;height:180px;background:rgba(232,160,32,.08);border-radius:50%;}
    .who-card::after{content:'';position:absolute;bottom:-30px;left:-30px;width:120px;height:120px;background:rgba(15,110,86,.12);border-radius:50%;}
    .who-card-icon{font-size:2.5rem;margin-bottom:20px;}
    .who-card h3{font-family:'Montserrat',sans-serif;font-size:1.3rem;font-weight:800;margin-bottom:14px;color:#fff;}
    .who-card p{font-size:.9rem;color:rgba(255,255,255,.78);line-height:1.75;}
    .who-card-tag{display:inline-block;background:rgba(232,160,32,.18);border:1px solid rgba(232,160,32,.3);color:var(--gold);font-size:.7rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:5px 14px;border-radius:20px;margin-top:20px;}
    .who-text h2{font-family:'Montserrat',sans-serif;font-size:clamp(1.6rem,3vw,2.2rem);font-weight:800;color:var(--navy);line-height:1.25;margin-bottom:20px;}
    .who-text h2 span{color:var(--gold);}
    .who-text p{font-size:.97rem;color:var(--light-text);line-height:1.8;margin-bottom:18px;}
    .who-points{display:flex;flex-direction:column;gap:14px;margin-top:24px;}
    .who-point{display:flex;align-items:flex-start;gap:14px;}
    .who-point-icon{width:40px;height:40px;background:rgba(15,110,86,.1);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0;}
    .who-point-text h4{font-family:'Montserrat',sans-serif;font-size:.88rem;font-weight:700;color:var(--navy);margin-bottom:3px;}
    .who-point-text p{font-size:.82rem;color:var(--light-text);line-height:1.6;}

    /* ── VALUES ── */
    .values-section{padding:90px 0;background:var(--light-bg);}
    .values-intro{text-align:center;margin-bottom:56px;}
    .values-intro .body-text{max-width:600px;margin:0 auto;}
    .values-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
    .value-card{background:#fff;border-radius:16px;padding:36px 28px;border:1px solid var(--border);text-align:center;transition:box-shadow .25s,transform .25s;}
    .value-card:hover{box-shadow:0 12px 40px rgba(26,58,92,.1);transform:translateY(-5px);}
    .value-icon{width:64px;height:64px;border-radius:16px;margin:0 auto 20px;display:flex;align-items:center;justify-content:center;font-size:1.8rem;}
    .value-icon.navy{background:rgba(26,58,92,.08);}
    .value-icon.gold{background:rgba(232,160,32,.1);}
    .value-icon.teal{background:rgba(15,110,86,.1);}
    .value-card h3{font-family:'Montserrat',sans-serif;font-size:1rem;font-weight:800;color:var(--navy);margin-bottom:10px;}
    .value-card p{font-size:.85rem;color:var(--light-text);line-height:1.7;}

    /* ── PROMISE ── */
    .promise-section{padding:90px 0;background:var(--navy);position:relative;overflow:hidden;}
    .promise-section::before{content:'';position:absolute;top:-80px;right:-80px;width:400px;height:400px;background:rgba(232,160,32,.05);border-radius:50%;}
    .promise-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;}
    .promise-text .label{color:var(--gold);}
    .promise-text h2{font-family:'Montserrat',sans-serif;font-size:clamp(1.6rem,3vw,2.2rem);font-weight:800;color:#fff;line-height:1.25;margin-bottom:20px;}
    .promise-text h2 span{color:var(--gold);}
    .promise-text p{font-size:.97rem;color:rgba(255,255,255,.75);line-height:1.8;margin-bottom:14px;}
    .promise-items{display:flex;flex-direction:column;gap:16px;}
    .promise-item{display:flex;align-items:flex-start;gap:16px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:12px;padding:20px;}
    .promise-item-num{font-family:'Montserrat',sans-serif;font-size:1.5rem;font-weight:800;color:var(--gold);line-height:1;flex-shrink:0;width:36px;}
    .promise-item h4{font-family:'Montserrat',sans-serif;font-size:.9rem;font-weight:700;color:#fff;margin-bottom:4px;}
    .promise-item p{font-size:.82rem;color:rgba(255,255,255,.65);line-height:1.6;}

    /* ── WHY CHOOSE US ── */
    .why-section{padding:90px 0;background:#fff;}
    .why-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-top:48px;}
    .why-card{display:flex;align-items:flex-start;gap:18px;padding:28px;border:1px solid var(--border);border-radius:14px;transition:box-shadow .2s,border-color .2s;}
    .why-card:hover{box-shadow:0 8px 28px rgba(26,58,92,.1);border-color:var(--gold);}
    .why-card-icon{font-size:2rem;flex-shrink:0;width:52px;height:52px;background:var(--light-bg);border-radius:12px;display:flex;align-items:center;justify-content:center;}
    .why-card h4{font-family:'Montserrat',sans-serif;font-size:.95rem;font-weight:700;color:var(--navy);margin-bottom:6px;}
    .why-card p{font-size:.84rem;color:var(--light-text);line-height:1.65;}

    /* ── CTA ── */
    .cta-section{background:linear-gradient(135deg,#0d2540,var(--navy));padding:80px 24px;text-align:center;}
    .cta-section h2{font-family:'Montserrat',sans-serif;font-size:clamp(1.6rem,3.5vw,2.4rem);font-weight:800;color:#fff;margin-bottom:12px;}
    .cta-section h2 span{color:var(--gold);}
    .cta-section p{color:rgba(255,255,255,.75);font-size:1rem;max-width:520px;margin:0 auto 32px;line-height:1.75;}
    .cta-btns{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;}
    .btn-gold{display:inline-flex;align-items:center;gap:10px;background:var(--gold);color:var(--navy);font-family:'Montserrat',sans-serif;font-weight:800;font-size:1rem;padding:15px 36px;border-radius:8px;transition:background .2s,transform .15s;text-transform:uppercase;letter-spacing:.06em;}
    .btn-gold:hover{background:#d4911a;transform:translateY(-2px);}
    .btn-outline{display:inline-flex;align-items:center;gap:10px;background:transparent;color:#fff;font-family:'Montserrat',sans-serif;font-weight:700;font-size:1rem;padding:14px 32px;border-radius:8px;border:2px solid rgba(255,255,255,.3);transition:border-color .2s,color .2s;}
    .btn-outline:hover{border-color:var(--gold);color:var(--gold);}

    /* ── FOOTER ── */
    footer{background:#0d2030;color:rgba(255,255,255,.72);padding:60px 24px 0;}
    .footer-inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:2fr 1fr 1fr;gap:48px;padding-bottom:48px;}
    .footer-logo{height:70px;width:auto;filter:invert(1);mix-blend-mode:screen;}
    .footer-brand p{font-size:.85rem;line-height:1.75;margin-top:16px;max-width:300px;}
    .footer-col h4{font-family:'Montserrat',sans-serif;font-size:.8rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:#fff;margin-bottom:18px;}
    .footer-col ul{display:flex;flex-direction:column;gap:10px;}
    .footer-col ul li a{font-size:.83rem;color:rgba(255,255,255,.6);transition:color .2s;}
    .footer-col ul li a:hover{color:var(--gold);}
    .footer-bottom{border-top:1px solid rgba(255,255,255,.08);padding:24px 0;max-width:1200px;margin:0 auto;display:flex;flex-direction:column;align-items:center;gap:12px;}
    .footer-bottom p{font-size:.78rem;color:rgba(255,255,255,.4);text-align:center;}
    .footer-social{display:flex;gap:14px;}
    .footer-social a{width:36px;height:36px;border-radius:8px;background:rgba(255,255,255,.07);display:flex;align-items:center;justify-content:center;transition:background .2s;}
    .footer-social a:hover{background:var(--gold);}
    .footer-social a svg{width:18px;height:18px;fill:#fff;display:block;}
    .wa-float{position:fixed;bottom:28px;right:28px;z-index:999;width:56px;height:56px;background:#25d366;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(37,211,102,.4);font-size:1.6rem;transition:transform .2s,box-shadow .2s;}
    .wa-float:hover{transform:scale(1.08);box-shadow:0 6px 24px rgba(37,211,102,.55);}

    @media(max-width:960px){
      .who-grid,.promise-grid{grid-template-columns:1fr;}
      .values-grid{grid-template-columns:1fr 1fr;}
      .why-grid{grid-template-columns:1fr;}
    }
    @media(max-width:700px){
      .nav-links{display:none;flex-direction:column;position:absolute;top:100%;left:0;right:0;background:var(--navy);padding:20px 24px 28px;gap:6px;box-shadow:0 8px 24px rgba(0,0,0,.2);}
      .nav-links.open{display:flex;}
      .nav-links a{padding:12px 0;border-bottom:1px solid rgba(255,255,255,.07);font-size:1rem;}
      .hamburger{display:flex;}
      .values-grid{grid-template-columns:1fr;}
      .footer-inner{grid-template-columns:1fr;}
    }
  </style>
</head>
<body>

<!-- ═══ HEADER ═══ -->
<header>
  <div class="top-bar">
